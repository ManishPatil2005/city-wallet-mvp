# City Wallet Backend — Environment Variables
# Copy this file to .env and fill in your values

# Weather API (OpenWeatherMap free tier — sign up at openweathermap.org)
# Leave as "demo" to use deterministic fallback (always works)
WEATHER_API_KEY=demo

# JWT Secret for redemption tokens
JWT_SECRET=city-wallet-hackathon-secret-2026

# Server port
PORT=3001

# CORS allowed origin (consumer app URL)
CORS_ORIGIN=http://localhost:8081
